PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/control-gastos.sqlite
UPLOAD_DIR=./uploads

# 32 bytes encoded as base64. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SIPP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Auth0 API validation. Required in production.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.control-gastos-casas-petroil.local
ALLOW_DEVELOPMENT_USER=true

SIPP_STAGE_URL=https://stage.sipp.petroil.dev/
SIPP_PRODUCTION_URL=https://sipp.petroil.com.mx/
RPA_HEADLESS=true
RPA_TIMEOUT_MS=45000
# En Windows puede usarse msedge sin descargar Chromium. Déjalo vacío en servidores
# que ejecuten `playwright install chromium`.
RPA_BROWSER_CHANNEL=msedge
